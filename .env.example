# PostgreSQL Connection String
# Get from Supabase: Dashboard > Project > Connect > Application > Connection String
# Make sure to replace [YOUR-PASSWORD] with your actual database password
# Enable connection pooler on Supabase if using IPv6
PG_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-ID].supabase.co:5432/postgres?schema=public

# JWT Secret Token for signing authentication tokens
# Generate a secure random token (minimum 32 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ACCESS_TOKEN=your_very_secret_token_here_minimum_32_characters